{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app10",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3743a6c8-3681-4212-92da-62fb9c1cec57","database_name": "web-app10" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4fc9b60cde39440482783684e748584a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
